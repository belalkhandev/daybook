{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daybook",
  "version": "0.1.0",
  "identifier": "com.belal.daybook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daybook",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Productivity",
    "shortDescription": "Daily tasks and notes",
    "longDescription": "Daybook is an offline-first desktop app for daily tasks and notes with optional AI drafting.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3"],
        "section": "utils"
      }
    }
  }
}
