{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trove",
  "version": "0.4.0",
  "identifier": "com.belal.trove",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trove",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/trove/thumbs/**",
          "$CACHE/trove/**",
          "$PICTURE/Trove/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Productivity",
    "shortDescription": "Daily tasks and notes",
    "longDescription": "Trove is an offline-first desktop workspace for tasks, notes and screenshots with optional AI drafting.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3"
        ],
        "recommends": [
          "tesseract-ocr",
          "tesseract-ocr-eng",
          "xdg-desktop-portal"
        ],
        "section": "utils"
      }
    }
  }
}
